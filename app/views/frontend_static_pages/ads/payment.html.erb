<h2>Pay Online</h2>

<!-- The container where Cybersource will inject the buttons -->
<div id="payment-buttons"></div>

<!-- Hidden form to securely post the token back to your Rails server -->
<form id="process-payment-form" action="/payments/process" method="POST">
   <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
   <input type="hidden" id="flex-response" name="flex_response">
</form>

